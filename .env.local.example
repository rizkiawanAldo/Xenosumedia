# Admin Panel Environment Variables
# Copy this to .env.local (which is gitignored) for local dev

# SHA-256 hash of your admin password
# Generate with: node -e "const c=require('crypto');console.log(c.createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
VITE_ADMIN_PASS_HASH=<paste sha256 hash here>

# GitHub Personal Access Token
# Create at: https://github.com/settings/tokens
# Required scopes: repo (or fine-grained: Contents: Read and Write for this repo only)
VITE_GITHUB_PAT=<your github pat>

# Repository details (already set in deploy.yml, only needed locally)
VITE_GITHUB_OWNER=rizkiawanAldo
VITE_GITHUB_REPO=Xenosumedia
VITE_GITHUB_BRANCH=main
